# Example Nginx reverse-proxy fragment for CytoCV.
#
# Apply this on the deployed VM or whatever host actually terminates HTTP
# traffic in front of Gunicorn. This repository does not currently own the
# live Nginx service configuration.
#
# The current browser-side upload target is 80 MiB
# (`CYTOCV_UPLOAD_BATCH_TARGET_BYTES=83886080`), so keep
# `client_max_body_size` above that request size. `100M` is the minimum
# documented headroom for the current default. If you intentionally raise the
# browser upload target, raise this value too.

server {
    listen 80;
    server_name example.org;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
