[Unit]
Description=CytoCV Upload-Preparation Worker
After=network.target postgresql.service cytocv.service

[Service]
# Upload preparation is separated from full analysis so metadata parsing,
# preview generation, and restored-run handling can progress independently.
User=REPLACE_WITH_DEPLOY_USER
Group=REPLACE_WITH_DEPLOY_USER
WorkingDirectory=/home/REPLACE_WITH_DEPLOY_USER/CytoCV/cytocv
Environment="PATH=/home/REPLACE_WITH_DEPLOY_USER/CytoCV/cyto_cv/bin"
# The shared worker command is restricted to upload-preparation jobs here; this
# avoids loading the heavier analysis runtime in the preparation worker.
ExecStart=/home/REPLACE_WITH_DEPLOY_USER/CytoCV/cyto_cv/bin/python /home/REPLACE_WITH_DEPLOY_USER/CytoCV/cytocv/manage.py run_analysis_worker --job-type upload-preparation --skip-maintenance
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
