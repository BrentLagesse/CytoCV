%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":28,"rankSpacing":46}}}%%
flowchart LR
    classDef input fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef process fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef data fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef output fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;

    inputs["Source stack, mask.tif,<br/>channel config, scale context"]

    subgraph masks["Retained masks"]
        direction TB
        retain["Cell Inclusion Mode<br/>single, pair, or both"]
        refine["Refine retained masks<br/>cellpairs.tif"]
        geometry["Pair geometry<br/>neck split and parentage"]
    end

    subgraph images["Review image artifacts"]
        direction TB
        frames["Full-frame overlays<br/>by channel role"]
        crops["Per-cell crops<br/>outline and no-outline"]
        contours["Canonical contours<br/>clipped to retained mask"]
    end

    subgraph records["Statistics and persistence"]
        direction TB
        stats["Selected statistics<br/>plugin execution plan"]
        persist["Persist SegmentedImage<br/>and CellStatistics"]
        review["Display-ready run<br/>tables and overlays"]
    end

    inputs --> retain --> refine --> geometry
    refine --> frames --> crops --> contours --> stats --> persist --> review
    geometry --> contours
    geometry --> stats

    class inputs input
    class retain,refine,frames,crops,contours,stats process
    class geometry,persist data
    class review output
