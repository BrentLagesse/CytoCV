%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":28,"rankSpacing":46}}}%%
flowchart TD
    classDef input fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef mask fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef modern fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef legacy fill:#fef2f2,stroke:#f87171,color:#991b1b,stroke-width:1.2px;
    classDef output fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;

    crop["Per-cell crop<br/>from retained DIC mask"]
    cellmask["Cell or cell-pair mask<br/>single, pair, or both"]
    parentage["Pair geometry<br/>neck split and parentage"]
    canonical["Canonical contour slots<br/>clipped to DIC mask"]

    red["Red dot contours"]
    green["Green contours"]
    blue["Blue contours<br/>legacy when selected"]

    puncta["PunctaDistance<br/>paired, red-only, green-only"]
    gr["GreenRedIntensity<br/>total, max, mean intensity"]
    cen["CENDot<br/>mother/daughter classification"]
    bio["Biorientation<br/>on-axis and off-axis counts"]
    nuclear["NuclearCellPairIntensity<br/>cell, nucleus, cytoplasm"]
    legacy["Legacy Blue modules<br/>Nucleus, BlueNucleus, RedBlue"]

    row["CellStatistics row<br/>fields plus properties JSON"]
    overlays["Review artifacts<br/>overlays, crops, debug outputs"]
    export["Display and export<br/>applicability-aware values"]

    crop --> cellmask --> parentage --> canonical
    canonical --> red
    canonical --> green
    canonical --> blue

    red --> puncta
    green --> puncta
    red --> gr
    green --> gr
    red --> cen
    green --> cen
    parentage --> cen
    red --> bio
    green --> bio
    green --> nuclear
    red --> nuclear
    blue --> legacy
    red --> legacy
    green --> legacy

    puncta --> row
    gr --> row
    cen --> row
    bio --> row
    nuclear --> row
    legacy --> row
    row --> export
    canonical --> overlays
    row --> overlays

    class crop input
    class cellmask,parentage,canonical,red,green,blue mask
    class puncta,gr,cen,bio,nuclear modern
    class legacy legacy
    class row,overlays,export output
