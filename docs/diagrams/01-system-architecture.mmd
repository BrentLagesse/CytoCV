%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":34,"rankSpacing":54}}}%%
flowchart TD
    classDef actor fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef interface fill:#eff6ff,stroke:#60a5fa,color:#1d4ed8,stroke-width:1.3px;
    classDef service fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef science fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef data fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;
    classDef control fill:#f1f5f9,stroke:#64748b,color:#334155,stroke-width:1.2px;

    user[Research user]
    browser[Browser interface<br/>upload, configure, review, export]

    subgraph application["Django application layer"]
        direction LR
        workflow[Workflow views<br/>Experiment, Preprocess, Display]
        auth[Accounts and access control<br/>email, provider SSO, reCAPTCHA]
        progress[Progress and cancellation API]
    end

    subgraph jobs["Job coordination layer"]
        direction LR
        upload_jobs[UploadPreparationJob<br/>validation and previews]
        analysis_jobs[AnalysisJob<br/>preprocess, inference, statistics]
        worker[Background worker<br/>or synchronous fallback]
    end

    subgraph science["Scientific processing layer"]
        direction LR
        ingestion[Source and metadata<br/>.dv and stack TIFF]
        channel_scale[Channel and scale context<br/>DIC, Blue, Red, Green<br/>pixels or microns]
        segmentation[DIC-guided segmentation<br/>preprocess, Mask R-CNN, masks]
        quantification[Plugin statistics<br/>contours, distances, intensities,<br/>CEN, biorientation, nuclear]
        retention[Artifact retention<br/>saved or transient]
    end

    subgraph persistence["Persistence layer"]
        direction LR
        db[(Database<br/>runs, jobs, cells, statistics)]
        media[(MEDIA_ROOT artifacts<br/>sources, previews, masks,<br/>crops, overlays)]
        state[(Progress mirrors<br/>cancel markers, model weights)]
    end

    user --> browser --> workflow
    auth --> workflow
    workflow --> upload_jobs
    workflow --> analysis_jobs
    progress --> analysis_jobs
    upload_jobs --> worker
    analysis_jobs --> worker
    worker --> ingestion --> channel_scale --> segmentation --> quantification --> retention
    workflow --> db
    jobs --> db
    quantification --> db
    ingestion --> media
    segmentation --> media
    quantification --> media
    retention --> media
    progress --> state
    segmentation --> state

    class user actor
    class browser interface
    class workflow,auth,upload_jobs,analysis_jobs,worker service
    class progress,retention control
    class ingestion,channel_scale,segmentation,quantification science
    class db,media,state data
