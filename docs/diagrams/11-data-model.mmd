%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"14px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":24,"rankSpacing":38}}}%%
flowchart LR
    classDef entity fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef job fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.2px;
    classDef support fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef note fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.1px,stroke-dasharray: 4 3;

    user["<b>CustomUser</b><br/>id, email<br/>quota and preferences"]
    upload["<b>UploadedImage</b><br/>uuid, user<br/>source file path<br/>scale_info, created_at"]
    prep["<b>UploadPreparationJob</b><br/>job_uuid, user<br/>run UUID sets<br/>status, phase, detail"]
    analysis["<b>AnalysisJob</b><br/>job_uuid, batch_key<br/>run UUIDs<br/>status, phase, config_snapshot"]
    preview["<b>DVLayerTifPreview</b><br/>uploaded_image<br/>layer preview PNG<br/>wavelength label"]
    segmented["<b>SegmentedImage</b><br/>UUID, user<br/>run paths and counts<br/>cell_inclusion_mode"]
    stats["<b>CellStatistics</b><br/>segmented_image, cell_id<br/>cell_type, metric fields<br/>properties JSON"]
    channel["channel_config.json<br/>logical role mapping"]
    media["MEDIA_ROOT run folder<br/>source, previews, masks,<br/>crops, overlays"]
    link["Uploaded and segmented runs<br/>share a run UUID namespace"]

    user -- "owns" --> upload
    user -- "owns" --> prep
    user -- "owns" --> analysis
    user -- "owns saved runs" --> segmented
    upload -- "has previews" --> preview
    upload -- "uses" --> channel
    upload -- "stores files under" --> media
    prep -. "validates run UUIDs" .-> upload
    analysis -. "processes run UUIDs" .-> upload
    upload -. "shared UUID" .-> segmented
    segmented -- "has cells" --> stats
    segmented -- "stores results under" --> media
    link -.-> upload
    link -.-> segmented

    class user,upload,segmented,stats entity
    class prep,analysis job
    class preview,channel,media support
    class link note
