%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":28,"rankSpacing":48}}}%%
flowchart TD
    classDef source fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef artifact fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef record fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;
    classDef control fill:#f1f5f9,stroke:#64748b,color:#334155,stroke-width:1.2px;
    classDef delete fill:#fef2f2,stroke:#f87171,color:#991b1b,stroke-width:1.2px;

    src["Source upload<br/>.dv / stack TIFF"]

    subgraph setup["Upload preparation artifacts"]
        direction LR
        cfg["channel_config.json<br/>and scale_info"]
        preview["preview_images<br/>browser layer PNGs"]
    end

    subgraph processing["Analysis artifacts"]
        direction LR
        prep["preprocessed_images<br/>DIC and channel previews"]
        mask["output/mask.tif<br/>output/cellpairs.tif"]
        geometry["pair-geometry.json<br/>neck_split and outline sidecars"]
    end

    subgraph review["Review artifacts and records"]
        direction LR
        crops["segmented crops<br/>cell masks and no-outline images"]
        overlays["overlay-render-config.json<br/>overlay-cache-v4 PNGs"]
        stats["CellStatistics rows<br/>fields and properties JSON"]
    end

    owner["Run state<br/>saved or transient"]
    keep["Retain durable results<br/>for saved runs"]
    sweep["Cleanup<br/>cancelled, invalid, stale, unsaved"]
    delete["Delete transient artifacts<br/>and orphan rows"]

    src --> cfg --> preview --> prep --> mask --> geometry --> crops --> overlays --> stats --> owner
    owner --> keep
    owner --> sweep --> delete
    preview --> sweep
    prep --> sweep
    mask --> keep
    crops --> keep
    overlays --> keep
    stats --> keep

    class src source
    class cfg,preview,prep,mask,geometry,crops,overlays artifact
    class stats record
    class owner,sweep,keep control
    class delete delete
