%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":30,"rankSpacing":48}}}%%
flowchart TD
    classDef actor fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef process fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef optional fill:#eff6ff,stroke:#60a5fa,color:#1d4ed8,stroke-width:1.2px;
    classDef output fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;

    visitor[User]
    gate["Optional reCAPTCHA gate<br/>deployment controlled"]
    native["Native email workflow<br/>sign in, signup, recovery"]
    providers["Optional provider SSO<br/>Google and Microsoft via allauth"]
    verify["Email verification<br/>codes or provider confirmation"]
    session["Authenticated session"]
    workflow["Experiment workflow<br/>Dashboard and Display"]
    prefs["Workflow defaults<br/>plugin, scale, export settings"]
    account["Account management<br/>email and security settings"]

    visitor --> gate
    gate --> native
    gate --> providers
    native --> verify --> session
    providers --> verify
    providers --> session
    session --> workflow
    workflow --> prefs
    session --> account

    class visitor actor
    class gate,providers optional
    class native,verify,workflow,prefs,account process
    class session output
