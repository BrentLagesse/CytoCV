%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":32,"rankSpacing":46}}}%%
flowchart LR
    classDef channel fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef modern fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef single fill:#f0f9ff,stroke:#38bdf8,color:#075985,stroke-width:1.2px;
    classDef legacy fill:#fef2f2,stroke:#f87171,color:#991b1b,stroke-width:1.2px;
    classDef process fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef note fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.1px,stroke-dasharray:4 3;

    subgraph roles["1. Logical channel roles"]
        direction TB
        dic["DIC<br/>segmentation and mask reference"]
        blue["Blue<br/>legacy nucleus paths"]
        red["Red<br/>puncta and red anchors"]
        green["Green<br/>puncta and CEN signal"]
    end

    subgraph selection["2. User-selected analysis configuration"]
        direction TB
        plugins["Selected statistics plugins"]
        signal["Signal quantification mode<br/>paired, red-only, or green-only"]
        legacy["Optional legacy Blue plugins"]
    end

    subgraph requirements["3. Required channel classes"]
        direction TB
        always["All enabled analyses<br/>require DIC"]

        subgraph current["Current Red/Green paths"]
            direction LR
            paired["DIC + Red + Green<br/>PunctaDistance paired mode<br/>GreenRedIntensity<br/>CENDot<br/>Biorientation<br/>NuclearCellPairIntensity"]
            redonly["DIC + Red<br/>Red-only puncta mode"]
            greenonly["DIC + Green<br/>Green-only puncta mode"]
        end

        subgraph legacy_requirements["Legacy Blue paths"]
            direction LR
            bluegreen["DIC + Blue + Green<br/>NucleusIntensity legacy"]
            blueonly["DIC + Blue<br/>BlueNucleusIntensity legacy"]
            redblue["DIC + Red + Blue<br/>RedBlueIntensity legacy"]
        end
    end

    subgraph validation["4. Validation result"]
        direction TB
        note["TIFF/DV metadata and manual mapping<br/>resolve source layers into logical roles"]
        effective["Effective required roles<br/>union of enabled requirement classes"]
        upload["Upload validation<br/>rejects missing required channels"]
    end

    roles --> selection --> requirements
    requirements --> note
    note --> effective --> upload

    class dic,blue,red,green channel
    class paired modern
    class redonly,greenonly single
    class bluegreen,blueonly,redblue legacy
    class always,plugins,signal,legacy,effective,upload process
    class note note
