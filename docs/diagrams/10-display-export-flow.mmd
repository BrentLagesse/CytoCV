%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":30,"rankSpacing":48}}}%%
flowchart LR
    classDef input fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef process fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef data fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef output fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;

    run["Segmented run<br/>saved or transient"]
    stats["CellStatistics<br/>fields and properties"]
    table["Display/Dashboard table<br/>applicability-aware columns"]
    filters["Review filters<br/>cell type, saved state,<br/>puncta source count"]
    selection["Export selection<br/>all or selected metrics"]
    units["Spatial units<br/>pixels or microns"]
    single["Single-run export<br/>CSV or XLSX"]
    combined["Combined export<br/>multiple files"]
    save["Save, unsave,<br/>sync selected runs"]

    run --> stats --> table
    table --> filters --> selection
    table --> units --> selection
    selection --> single
    selection --> combined
    table --> save

    class run,stats input
    class table,filters,selection,units process
    class save data
    class single,combined output
