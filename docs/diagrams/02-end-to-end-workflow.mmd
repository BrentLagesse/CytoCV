%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fafc","primaryBorderColor":"#94a3b8","primaryTextColor":"#0f172a","secondaryColor":"#eff6ff","tertiaryColor":"#eef2ff","lineColor":"#475569","fontFamily":"Arial","fontSize":"16px","clusterBorder":"#cbd5e1","clusterBkg":"#ffffff"},"flowchart":{"htmlLabels":true,"curve":"linear","nodeSpacing":32,"rankSpacing":52}}}%%
flowchart LR
    classDef input fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1.4px;
    classDef process fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1.2px;
    classDef analysis fill:#ecfdf5,stroke:#4ade80,color:#166534,stroke-width:1.2px;
    classDef output fill:#eef2ff,stroke:#818cf8,color:#3730a3,stroke-width:1.2px;

    subgraph intake["1. Upload"]
        direction TB
        files[".dv or stack .tif/.tiff<br/>one run per source stack"]
        settings["Plugin, channel,<br/>cell inclusion, scale settings"]
    end

    subgraph validation["2. Validation and setup"]
        direction TB
        validate["Format, layer, and<br/>required-channel validation"]
        map["Channel preview and mapping<br/>DIC, Blue, Red, Green"]
        scale["Scale metadata or<br/>manual microns per pixel"]
    end

    subgraph compute["3. Computation"]
        direction TB
        preprocess["DIC and fluorescence<br/>preprocessing"]
        infer["Mask R-CNN inference<br/>from DIC"]
        mask["Write output/mask.tif<br/>and cellpairs.tif"]
        segment["Cell inclusion and<br/>candidate selection"]
        stats["Plugin statistics<br/>contours, distances, intensities"]
    end

    subgraph review["4. Review and export"]
        direction TB
        display["Display and Dashboard<br/>visual review"]
        persist["Saved or transient<br/>run storage"]
        export["Filtered CSV/XLSX<br/>cell metrics"]
    end

    files --> validate
    settings --> validate
    validate --> map --> scale --> preprocess --> infer --> mask --> segment --> stats --> display
    display --> persist
    display --> export

    class files,settings input
    class validate,map,scale,preprocess,infer,mask,segment process
    class stats analysis
    class display,persist,export output
